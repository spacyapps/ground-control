{
  "$schema": "https://groundcontrol.app/theme.schema.json",
  "manifestVersion": 1,

  // ---------------------------------------------------------------------
  // This file is the reference: EVERY key a theme may set, with the value
  // the app uses when you leave it out. It is documentation, not a look —
  // "reference": true keeps it out of the theme picker, because choosing it
  // could not change anything.
  //
  // To make a theme: copy a folder that already works (example-avatars for
  // avatars, spacyAppsLunarAvatar for a full nine-slice frame) and change
  // what you want. Come here to find out what a key is called and what it
  // does. Delete any key to get the value shown below.
  //
  // `//` comments and trailing commas are tolerated by the loader, so you
  // may annotate your own manifest the same way.
  // ---------------------------------------------------------------------

  "reference": true,

  "name": "Default",
  "author": "GroundControl",
  "description": "Every key a theme may set, with the app's own default beside it.",

  // Any colour may be "#rgb", "#rrggbb" or "#rrggbbaa".
  "colors": {
    "windowBackground":  "#0e0e12",  // behind everything
    "titleBarBackground":"#16161d",
    "titleBarText":      "#e6e6ec",

    "rowBackground":     "#14141c",  // give these alpha if artwork is behind
    "rowBackgroundAlt":  "#181820",  // alternating rows
    "rowBackgroundHover":"#1f1f2b",

    "sessionName":       "#e6e6ec",
    "message":           "#b9b9c6",
    "messageDim":        "#7a7a8a",  // stale or idle text

    "needsAction":       "#ff2d55",  // the alarm. Red for a reason.
    "working":           "#39c5ff",
    "idle":              "#5a5a6a",

    "footerBackground":  "#16161d",
    "footerText":        "#8a8a99",
    "accent":            "#39ff14",
    "divider":           "#26263200"
  },

  // Images drawn as backgrounds. Each may be null, a bare filename, or an
  // object as shown. Nine-slicing here works exactly as it does for `window`.
  "assets": {
    "windowBackground": {
      "image":            null,   // filename beside this theme.json
      "mode":             null,   // "tile" | "stretch"
      "capInsets":        null,   // { top, left, bottom, right } — see `window`
      "removeBackground": null    // "auto" | "checkerboard" | a hex to key out
    },
    "titleBarBackground": null,   // same shape as above
    "footerBackground":   null,
    "needsActionDot":     null,   // replaces the drawn alarm dot
    "brandMark":          null    // replaces the logo shown when no sessions exist
  },

  // The face on each row. This is where most themes spend their effort.
  "avatar": {
    "size":         36,           // points. 0 hides avatars entirely.
    "position":     "right",      // "left" | "right"
    "cornerRadius": 8,
    "states": {
      // Each state takes an image (still, or animated gif/apng) OR a video —
      // set whichever key you want; video wins if both are set. Video means
      // .mov/.mp4/.m4v (H.264 or HEVC) — not .webm, no native decoder for it.
      // Draw at 2x the avatar size at minimum: 72px for a 36pt avatar, and
      // most themes set a larger size than this default.
      "idle":       { "image": null, "video": null, "loop": true, "muted": true },
      "working":    { "image": null, "video": null, "loop": true, "muted": true },
      "needsInput": { "image": null, "video": null, "loop": true, "muted": true },
      "done":       { "image": null, "video": null, "loop": true, "muted": true }
    }
  },

  // The panel's own shape and frame. Absent, the panel is a plain rectangle.
  "window": {
    // The skin ("shape" is an older spelling) — a still or animated gif/apng,
    // by filename. No video here: the frame is nine-sliced, cut into corners,
    // edges and a tiled middle and redrawn as bitmaps every frame, and a video
    // layer has no nine-slice concept to be cut along at all.
    "image":            null,
    "shape":            null,
    "overlay":          false,    // true draws the skin IN FRONT of the rows,
                                  // so the frame covers what it overlaps
    "bodyFade":         false,    // overlay only: solid body to the analyser,
                                  // fading out over the first row; rows below
                                  // float on the frame as rounded cards. Give
                                  // rowBackground/rowBackgroundAlt some alpha
    "lockAspect":       false,    // superseded by layout.resize; still read
    "removeBackground": null,     // "auto" | "checkerboard" | hex, e.g. "#00FF00"
    "mode":             null,     // "tile" | "stretch" for the sliced edges
    // Where your corner artwork ends, in the image's own pixels. Set these and
    // the image is nine-sliced: corners fixed, edges repeated, centre filled.
    // Measure them off the drawing you actually made — a cap that stops short
    // leaves part of an ornament in the tiled strip, which then repeats it
    // along the edge.
    // All four zero means "do not slice", which is the same as leaving it out.
    "capInsets": { "top": 0, "left": 0, "bottom": 0, "right": 0 }
  },

  // Fixed art in a panel corner: 1 to 4 independent pieces, sized off their
  // own pixels — never sliced, never resized by the panel resizing. Sits
  // above the frame and below the close/resize marks. A theme sets any
  // subset of the four; each is null unless given an image or video. Every
  // field below applies to each of the four the same way. Anything that
  // moves is baked into one fixed canvas — the app never slides a decoration,
  // so a bird flying across the corner is one wide image with the whole path
  // drawn into it.
  "cornerDecorations": {
    "topLeft": {
      "image":            null,   // a filename, or a list of them — a still or
                                  // gif/apng each. A list plays end to end and
                                  // loops while working, freezing at rest.
      "video":            null,   // a .mov/.mp4/.m4v — wins over `image` if both are set
      "loop":             true,   // video only
      "muted":            true,   // video only
      "removeBackground": null,   // "auto" | "checkerboard" | hex — image/gif only, not video
      // Multiplies the artwork's own pixel size. 1 is the file's real size.
      // Trying a different size is a number to change here, not a new image
      // to generate — the anchor and offset below are computed against the
      // scaled size, so scaling down brings the art in from the corner.
      "scale": 1,
      // Screen direction from this corner's own point: x right, y down, the
      // same meaning at every corner. {0,0} means the artwork's own matching
      // corner sits exactly on the window's — e.g. bottomRight's bottom-right
      // pixel on the window's bottom-right pixel, growing left and up from
      // there. Offsets can be large; the artwork is only ever clipped by the
      // window's own edge, never by anything else.
      "offset": { "x": 0, "y": 0 }
    },
    "topRight":    null,
    "bottomLeft":  null,
    "bottomRight": null
  },

  // The title-bar analyser: its palette, what it says, and how it moves.
  // feel / patterns / patternHold / sleep are named levels, not raw numbers —
  // see docs/MATRIX-CUSTOMISATION.md. Every value below is the built-in one, so
  // this block changes nothing.
  "matrix": {
    "low":      null,             // defaults to colors.accent
    "high":     null,             // defaults to colors.working
    "alarm":    null,             // defaults to colors.needsAction
    "unlit":    null,             // defaults to colors.divider at 10% alpha
    "text":     null,             // defaults to colors.titleBarText
    "peak":     null,             // defaults to colors.titleBarText at 70%
    "messages": [],               // replaces the built-in phrases. A theme is a
                                  // character; this is how it speaks.

    "feel": {
      "fall":        "medium",    // still | slow | medium | fast  (how the bars settle)
      "jitter":      null,        // none | calm | lively | chaotic; null keeps each
                                  //   pattern's own noise
      "sensitivity": "steady",    // mellow | steady | eager  (working count -> height)
      "speed":       "medium"     // slow | medium | fast  (how fast a wave travels)
    },
    "patterns": [                 // which shapes rotate; [] means all eight
      "wave", "ripple", "chase", "pyramid",
      "sawtooth", "butterfly", "heartbeat", "spectrum"
    ],
    "patternHold": "medium",      // short | medium | long  (seconds per shape)
    "sleep": {
      "face": "-  ‿  -",          // shown when nothing is running
      "zzz":  true
    },

    // Per-state bar formulas — pure math over pos, phase, energy, bar, count.
    // See docs/MATRIX-CUSTOMISATION.md for the vocabulary and the swell example.
    // Each null: that state keeps its built-in behaviour.
    "shape": {
      "working":    null,          // else: the pattern rotation while working
      "needsInput": null,          // else: flat, lit red floor. A formula strobes
                                   //   for ~15s then settles to that floor.
      "done":       null,          // else: no flourish. A formula (with decay())
                                   //   blooms once when a turn finishes.
      "idle":       null           // else: flat / the sleep face
    }
  },

  "layout": {
    "resize":              "content",  // "content" grows with the rows
                                       // "aspect"  keeps the artwork's shape
                                       // "free"    any size (needs capInsets)
    // Pads the ROWS away from your frame. A bare number means all four sides.
    // Not to be confused with window.capInsets, which cuts the ARTWORK — they
    // have been swapped before, and the result looks like a corrupt image
    // rather than a wrong number.
    "contentInset": { "top": 0, "left": 0, "bottom": 0, "right": 0 },
    // For a frame with a deep top decoration (a roof, an arch), nine-slice only:
    "frameOffsetTop":     0,           // push the frame's top cap down this far,
                                       // desktop shows above it
    "titleBackdropTop":   0,           // how far the opaque panel body reaches
                                       // up behind that decoration — its ground,
                                       // so the frame's keyed gaps read as panel
    "contentCornerRadius": 0,
    "rowMaxHeight":        100,
    "rowPadding":          10,
    "marqueeOnOverflow":   true,       // scroll a message too long to fit
    "marqueeSpeed":        40,
    "density":             "comfortable"  // "comfortable" | "compact"
  },

  "typography": {
    "fontFamily":  null,          // null uses the system font
    "nameSize":    13,
    "messageSize": 11,
    "nameWeight":  "semibold"
  }
}
