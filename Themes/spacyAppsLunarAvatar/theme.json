{
  "manifestVersion": 1,
  "name": "SpacyApps Lunar Avatar",
  "description": "A space station drawn in front of the rows: window.overlay with a green-keyed middle, so the hull and its dishes overlap the panel edges.",
  "colors": {
    "windowBackground": "#0a0a12",
    "titleBarBackground": "#160f22cc",
    "titleBarText": "#e8d4ff",
    "footerBackground": "#160f22",
    "rowBackground": "#120c1cbb",
    "rowBackgroundAlt": "#160f22bb",
    "rowBackgroundHover": "#1f1630dd",
    "sessionName": "#e8d4ff",
    "message": "#c4a8e8",
    "messageDim": "#8a6fa8",
    "needsAction": "#ff2d55",
    "working": "#39c5ff",
    "idle": "#4a90e2",
    "accent": "#39ff14",
    "divider": "#2a1f3a00"
  },
  "avatar": {
    "size": 48,
    "position": "right",
    "cornerRadius": 8,
    "states": {
      "idle": {
        "image": "idle.png"
      },
      "working": {
        "image": "working.gif"
      },
      "needsInput": {
        "image": "needs-input.gif"
      },
      "done": {
        "image": "done.png"
      }
    }
  },
  "layout": {
    "rowMaxHeight": 100,
    "marqueeOnOverflow": true,
    "density": "comfortable",
    "contentInset": {
      "top": 120,
      "left": 110,
      "bottom": 100,
      "right": 110
    },
    "contentCornerRadius": 0,
    "resize": "free"
  },
  "matrix": {
    "messages": [
      "SYSTEM ONLINE",
      "NEURAL LINK",
      "STANDING BY",
      "UPLINK OPEN",
      "ALL NOMINAL",
      "DEEP SPACE",
      "COMMS CLEAR",
      "ORBIT STABLE"
    ]
  },
  "window": {
    "image": "frame.png",
    "lockAspect": false,
    "overlay": true,
    "removeBackground": "#00FF00",
    "mode": "stretch",
    "capInsets": {
      "top": 150,
      "left": 150,
      "bottom": 150,
      "right": 150
    }
  },
  "author": "SpacyApps"
}
