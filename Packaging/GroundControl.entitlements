<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Notarisation requires the hardened runtime, and under it an app cannot
         send Apple Events without this. Without it TerminalFocuser fails
         silently in a shipped build while working perfectly under `swift run`. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
