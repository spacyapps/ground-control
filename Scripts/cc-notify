"""
cc-notify — agent-CLI hook emitter for GroundControl.

Reads a hook payload on stdin and appends one JSON line to that session's
file. Field names below are not guesses: they were captured from live hook
payloads on Claude Code 2.1.226 and Grok. See docs/HOOK-PAYLOADS.md for the
raw dumps and docs/LIMITATIONS.md for which CLIs are proven.

Serves several CLIs from one script. Claude Code uses snake_case and Grok
camelCase, but the events and their meanings are identical, so `get()` reads
either spelling rather than shipping an adapter per vendor.

(The name is historical — it predates Grok support. Renaming it would break
every installed settings.json that points at ~/bin/cc-notify.)

Install one line per event — no arguments needed, the payload names its own
event. Grok reads ~/.claude/settings.json too, so one install covers both:

    { "type": "command", "command": "~/bin/cc-notify" }

Output layout (${TMPDIR}/groundcontrol/):

    <session_id>.jsonl                  one per session   -> one row
    agents/<session_id>__<agent_id>.jsonl  one per subagent -> one child row

Contract with the app: the LAST line of a file is that row's current state.

This script must never block Claude. Every failure path exits 0 silently.
"""

import datetime
import json
import os
import shutil
import subprocess
import sys
import time

SCHEMA = 1
MAX_MESSAGE = 240

# Events that map to a row state. Anything else is ignored rather than written,
# so a future or unrecognised event can never blank out a row's message.
SESSION_EVENTS = (
    "userpromptsubmit", "pretooluse", "posttooluse", "notification", "stop",
    "sessionstart",
)


def get(payload, *names):
    """Reads a field under any of its spellings.

    Claude Code uses snake_case, Grok camelCase — but the events and their
    meanings are identical, so one emitter serves both rather than shipping a
    script per CLI. Unknown CLIs that follow either convention work for free.
    """
    for name in names:
        value = payload.get(name)
        if value not in (None, ""):
            return value
    return None


def source_of(payload):
    """Which CLI produced this. Session ids are only unique per tool, and rows
    from different tools are worth telling apart."""
    # opencode has no hook commands at all — a plugin calls us and says so,
    # because nothing in its own event shape would let us guess. Measured
    # 2026-08-19 against opencode 1.17.8; see docs/HOOK-PAYLOADS.md.
    if payload.get("source") == "opencode":
        return "opencode"
    # Checked before Claude: Cursor uses snake_case fields and the same
    # `hook_event_name` key, so the two are indistinguishable without this.
    if "cursor_version" in payload:
        return "cursor"
    if "hookEventName" in payload:
        return "grok"
    if "hook_event_name" in payload:
        return "claude"
    return "unknown"


# Events that mean what one of ours means under another name. Measured from a
# real Cursor session, not read off its docs: three of its events — sessionStart,
# preToolUse and stop — already normalise to our spelling and need nothing here.
ALIASES = {
    "beforesubmitprompt": "userpromptsubmit",   # Cursor: carries `prompt`, as ours does
    # opencode names its lifecycle differently and splits "waiting for you" into
    # asked/replied, which maps onto our notification/stop pair exactly.
    "session.created": "sessionstart",
    "session.idle": "stop",
    "permission.asked": "notification",
    "permission.replied": "stop",
}


def canonical_event(payload):
    """Normalises `session_start` / `SessionStart` to one spelling."""
    raw = get(payload, "hook_event_name", "hookEventName") or ""
    flattened = raw.replace("_", "").lower()
    return ALIASES.get(flattened, flattened)


def timestamp_of(payload):
    """Grok sends an ISO string; Claude sends nothing and we use the clock."""
    raw = get(payload, "timestamp")
    if isinstance(raw, str):
        try:
            text = raw.replace("Z", "+00:00")
            return int(datetime.datetime.fromisoformat(text).timestamp())
        except Exception:
            pass
    return int(time.time())


def sessions_dir():
    base = os.environ.get("TMPDIR") or "/tmp"
    return os.path.join(base, "groundcontrol")


class ProcessTree:
    """The ancestry, read one process at a time and remembered.

    Both walks below climb the same chain, so sharing a cache means each `ps`
    runs once rather than once per walk.

    Reading every process instead — a single `ps -axo` — was tried and measured
    *slower*: about 900 rows to fetch and parse against the handful of `ps -p`
    calls a walk actually makes. Hooks run on every tool call, so this is worth
    knowing rather than assuming.
    """

    def __init__(self):
        self._entries = {}

    def entry(self, pid):
        """(ppid, tty, command) for a pid, or None if it has gone."""
        if pid not in self._entries:
            self._entries[pid] = self._read(pid)
        return self._entries[pid]

    @staticmethod
    def _read(pid):
        try:
            out = subprocess.run(
                ["ps", "-o", "ppid=,tty=,comm=", "-p", str(pid)],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip()
        except Exception:
            return None

        # The command is a path and may contain spaces, so it takes the rest.
        parts = out.split(None, 2)
        if len(parts) < 3:
            return None
        try:
            return (int(parts[0]), parts[1], parts[2])
        except ValueError:
            return None


def walk_up(tree, start, pick):
    """Climbs the ancestry from `start`, returning the first answer `pick` gives.

    Bounded: a cycle or a very deep tree must not hang a hook, because a hook
    that hangs is a CLI that hangs.
    """
    pid = start
    for _ in range(16):
        entry = tree.entry(pid)
        if entry is None:
            return None
        found = pick(entry)
        if found is not None:
            return found
        pid = entry[0]
        if pid <= 1:
            return None
    return None


def resolve_tty(tree):
    """The controlling terminal, e.g. "/dev/ttys008".

    A hook runs with stdin bound to the payload pipe, so `tty` here always
    reports "not a tty". The spawning `claude` process does hold one, a few
    levels up. None when not run from a terminal at all.
    """
    def pick(entry):
        term = entry[1]
        if term and term != "??":
            return term if term.startswith("/") else "/dev/" + term
        return None

    return walk_up(tree, os.getpid(), pick)


def resolve_host_app(tree):
    """The app the terminal belongs to, as a path to its .app.

    A tty alone only identifies a tab inside iTerm or Terminal. Everything else
    that hosts a shell — VS Code and its forks, Warp, Ghostty, WezTerm — owns a
    real pty that matches no scriptable tab, so a click there had nowhere to go
    but Finder. The owning application is knowable here and nowhere else.

    Starts at the parent: this script's own interpreter can itself be an app
    binary. /usr/bin/python3 with the developer tools installed is really
    "/Applications/Xcode.app/.../Python.app/Contents/MacOS/Python" — measured,
    and it reported Xcode as the terminal for every session on the machine.

    Takes the **topmost** app in the ancestry, not the first one found. An
    agent can be hosted by an app that ships its own copy of the CLI as a
    separate bundle: Claude for Desktop runs
    "~/Library/Application Support/Claude/claude-code/<v>/claude.app", which is
    a real .app and therefore the first match, but is not an app anyone can
    switch to — it never appears in the Dock and never runs in the foreground.
    A row for it fell straight past `isBundleRunning` and landed the click in
    Finder.

    Measured on the three hosts present here. Terminal and Xcode name the same
    app either way; only the desktop app differs, where the first is that inner
    bundle and the topmost is /Applications/Claude.app. Nested helpers inside a
    real app — VS Code's renderers — were already handled by `outermost_app`,
    which climbs out of the bundle it is given; this climbs out of the process
    tree, which is the case that one cannot see.
    """
    found = []
    walk_up(tree, os.getppid(), lambda entry: found.append(outermost_app(entry[2])) or None)
    apps = [app for app in found if app]
    return apps[-1] if apps else None


def outermost_app(path):
    """The application whose executable this is, or None.

    Two traps, both found by measuring rather than reading.

    It must be an app's *own* binary, under `.app/Contents/MacOS/`. Merely
    living inside a bundle is not enough, or the Xcode-provided python above
    counts as an application.

    And it is the *outermost* .app. Electron nests helper bundles inside the
    app — VS Code spawns terminals under
    ".../Visual Studio Code.app/Contents/Frameworks/Code Helper.app/..." — and
    the inner one's bundle id is "com.github.Electron.helper", shared by every
    Electron app installed, so acting on it could raise something else entirely.
    """
    if ".app/Contents/MacOS/" not in path:
        return None
    marker = ".app/"
    return path[: path.find(marker) + len(marker) - 1]


def resolve_host_id():
    """The owning app's bundle id, straight from the environment.

    LaunchServices sets __CFBundleIdentifier on an app it starts and every child
    inherits it — measured as "com.apple.Terminal" from a shell in Terminal.app.
    A second opinion, kept because it survives cases the walk does not and costs
    nothing.
    """
    value = os.environ.get("__CFBundleIdentifier") or ""
    return value.strip() or None


def condense(text, limit=MAX_MESSAGE):
    """Collapse a possibly-multiline, possibly-markdown blob to one row line."""
    if not text:
        return ""
    for raw in str(text).splitlines():
        line = raw.strip()
        if not line:
            continue
        # Skip fence/heading noise so the row shows real prose.
        if line.startswith("```"):
            continue
        line = line.lstrip("#> ").strip()
        line = line.replace("**", "").replace("`", "")
        if not line:
            continue
        return line[:limit - 1] + "…" if len(line) > limit else line
    return ""


def last_line(path):
    try:
        with open(path, "r", errors="ignore") as handle:
            lines = [ln for ln in handle if ln.strip()]
        return json.loads(lines[-1]) if lines else None
    except Exception:
        return None


def asked_question(payload):
    """The question an agent is putting to you, or None.

    Measured from a real payload rather than guessed: `AskUserQuestion` carries
    `tool_input.questions[0].question`, a *list of objects* — which is why the
    flat-key search below walked straight past it and every such row read
    "Working… (AskUserQuestion)".

    Only the question. The options belong to whoever is answering, and they
    answer in the terminal — a row exists to tell you whether to get up.
    """
    tool_input = get(payload, "tool_input", "toolInput")
    if not isinstance(tool_input, dict):
        return None
    questions = tool_input.get("questions")
    if not isinstance(questions, list) or not questions:
        return None
    first = questions[0]
    if not isinstance(first, dict):
        return None
    text = first.get("question") or first.get("header")
    if not isinstance(text, str) or not text.strip():
        return None
    # The full budget, not the 160 a tool description gets. A question's tail is
    # where the decision usually is — "…changed sinc…" is worse than no help at
    # all — and the row scrolls, so length costs nothing but time.
    return condense(text)


def describe_tool(payload):
    """Best available phrasing for what the agent is doing right now."""
    tool = get(payload, "tool_name", "toolName") or "tool"
    question = asked_question(payload)
    if question:
        # Without the tool name: "AskUserQuestion: …" is noise in front of the
        # only words on the row that a person needs to read.
        return question
    tool_input = get(payload, "tool_input", "toolInput")
    if isinstance(tool_input, dict):
        for key in ("description", "file_path", "pattern", "command", "prompt"):
            value = tool_input.get(key)
            if isinstance(value, str) and value.strip():
                return "%s: %s" % (tool, condense(value, 160))
    return "Working… (%s)" % tool


def opening_line(payload):
    """A row label taken from a first prompt, or None if this is not one.

    Kept short: it sits beside the folder-derived names of every other row, and
    a sentence there would push the message out of the panel.
    """
    if canonical_event(payload) != "userpromptsubmit":
        return None
    text = condense(strip_wrapper(get(payload, "prompt")), limit=38)
    if not text:
        return None
    return text


def strip_wrapper(text):
    """Grok wraps prompts in <user_query> tags; the row wants the words."""
    if not isinstance(text, str):
        return text
    for tag in ("user_query", "user-query"):
        text = text.replace("<%s>" % tag, "").replace("</%s>" % tag, "")
    return text.strip()


def interpret(payload):
    """Map a hook event to (state, message, needs_action), or None to skip."""
    event = canonical_event(payload)

    if event == "notification":
        # "idle_prompt" means Claude finished and is waiting for your next
        # message — not that it is blocked on you. Treating it as an alarm
        # turned every finished session red, which makes red mean nothing, and
        # it overwrote the Stop line's real text with a generic phrase.
        #
        # Stop already says "your turn", with a better message. So skip it, and
        # keep the alarm for every other type — the ones that genuinely block.
        #
        # Note the polarity: alarm by default, and name the exception. Two types
        # have since arrived that were never coded for. Claude's
        # "permission_prompt" (2026-08-12) and Grok's "elicitation_dialog"
        # (2026-08-19), the latter absent from Grok's own documentation, both
        # worked on first contact and carried the real question text. A
        # whitelist would have dropped them without a sound. Do not invert this.
        #
        # The two permission gates stay quiet under permission_mode "auto",
        # which is why the log held none of them for so long. Grok's
        # elicitation does not: asking a question is a tool it chooses, not a
        # gate, so it fires in auto too. Do not reason from an empty log.
        if (get(payload, "notification_type", "notificationType") or "") == "idle_prompt":
            return None
        return "needsInput", condense(get(payload, "message")) or "Needs your input", True

    if event == "stop":
        message = get(payload, "last_assistant_message", "lastAssistantMessage")
        return "done", condense(message) or "Done", False

    if event == "userpromptsubmit":
        return "working", condense(strip_wrapper(get(payload, "prompt"))) or "Working…", False

    if event == "pretooluse":
        return "working", describe_tool(payload), False

    if event == "posttooluse":
        # The event that ends an alarm. A question raises one, and answering it
        # produces nothing at all: no Stop, no notification, no prompt. The row
        # stayed red until the agent happened to call its next tool — measured
        # at 147 seconds on a real Grok session, all of it spent thinking, with
        # the panel insisting it needed attention it did not need.
        #
        # A tool completing always means work resumed, whatever the tool, so
        # this is safe to state unconditionally. It is registered with a matcher
        # for the question tools alone, because firing on every tool would
        # double the write volume to say what PreToolUse already said.
        return "working", "Working…", False

    if event == "sessionstart":
        # Grok announces sessions before any work happens, so the row can exist
        # from the moment you open the CLI rather than at the first prompt.
        return "idle", "Session started", False

    return "idle", "", False


def emit(path, record):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + "\n")


def handle_subagent(payload, root, now, finished):
    """Subagents share the parent's tty and session id, so they get their own
    file under agents/ — keeping the file <-> row invariant intact one level
    down. The app groups them by the session id prefix.

    Grok fires SubagentStart as well as SubagentStop, so its children can show
    up while they are still running; Claude Code only announces the stop."""
    agent_id = get(payload, "agent_id", "agentId")
    session_id = get(payload, "session_id", "sessionId")
    if not agent_id or not session_id:
        return
    message = get(payload, "last_assistant_message", "lastAssistantMessage")
    path = os.path.join(root, "agents", "%s__%s.jsonl" % (session_id, agent_id))
    emit(path, {
        "schema": SCHEMA,
        "session_id": session_id,
        "agent_id": agent_id,
        "agent_type": get(payload, "agent_type", "agentType") or "",
        "state": "done" if finished else "working",
        "message": condense(message) or ("Finished" if finished else "Working…"),
        "needs_action": False,
        "ts": now,
    })


def handle_session_end(session_id, root):
    """A CLI that says goodbye should not wait 24h to disappear.

    Claude Code leaves sessions to age out on mtime; Grok fires SessionEnd. The
    file <-> row invariant does the rest — remove the files and the rows go."""
    path = os.path.join(root, "%s.jsonl" % session_id)
    try:
        os.remove(path)
    except OSError:
        pass

    agents = os.path.join(root, "agents")
    try:
        for name in os.listdir(agents):
            if name.startswith(session_id + "__"):
                os.remove(os.path.join(agents, name))
    except OSError:
        pass


def main():
    raw = sys.stdin.read()
    payload = json.loads(raw)
    if not isinstance(payload, dict):
        return

    session_id = get(payload, "session_id", "sessionId")
    if not session_id:
        return

    root = sessions_dir()
    now = timestamp_of(payload)
    event = canonical_event(payload)

    if event in ("subagentstop", "subagentend"):
        handle_subagent(payload, root, now, finished=True)
        return

    if event == "subagentstart":
        handle_subagent(payload, root, now, finished=False)
        return

    if event == "sessionend":
        handle_session_end(session_id, root)
        return

    if event not in SESSION_EVENTS:
        return

    path = os.path.join(root, "%s.jsonl" % session_id)
    previous = last_line(path) or {}
    # Cursor sends `cwd` as an empty string and puts the real answer in
    # `workspace_roots`. Falling through to os.getcwd() would name every Cursor
    # row after ~/.cursor, which is where its hooks run from.
    roots = get(payload, "workspace_roots", "workspaceRoots")
    root = roots[0] if isinstance(roots, list) and roots else None
    cwd = (get(payload, "cwd", "workspaceRoot") or root
           or previous.get("cwd") or os.getcwd())

    # session_title is the name you gave the session in Claude and is the better
    # label when it differs from the folder ("spacyapps" vs "fluffy-carnival").
    # It only ships on UserPromptSubmit, so latch it from the previous line.
    title = get(payload, "session_title", "sessionTitle")
    folder = os.path.basename(cwd.rstrip("/"))
    source = source_of(payload)
    name = title or previous.get("name") or folder

    # Cursor keeps several chats open against one workspace, so the folder names
    # them all the same thing. It titles them itself — "Free service inquiry" —
    # but that title is app state reached through an internal MCP tool, absent
    # from both the hook payload and the transcript on disk.
    #
    # The opening prompt is what Cursor derives its own title from, and it is
    # right there in the payload. Latched, so the row keeps the question it
    # started from rather than following the conversation.
    # Cursor only. Claude and Grok give one session per terminal, where the
    # folder is the useful label and a first prompt would be noise — replacing
    # "avaterm" with "hello" was caught by a test rather than by taste.
    if source == "cursor":
        # "workspace: empty" rather than "empty" while nothing better is known:
        # a row can be created by a tool event long before any prompt is seen,
        # and a bare folder name there reads as the name of one chat when it is
        # really the container several of them share.
        placeholder = "workspace: %s" % folder
        if name in (folder, placeholder):
            name = opening_line(payload) or placeholder

    interpreted = interpret(payload)
    if interpreted is None:
        return
    state, message, needs_action = interpreted

    # The question and the alarm arrive on different events, six seconds apart:
    # PreToolUse carries the words, Notification turns the row red with a
    # generic "Claude needs your permission". Last line wins, so without this
    # the words are overwritten by the moment they matter most. Latched the same
    # way tty and host_app are.
    asked = asked_question(payload) or previous.get("asked") or ""
    if state == "needsInput" and asked:
        message = asked

    tree = ProcessTree()
    tty = resolve_tty(tree) or previous.get("tty")
    host_app = resolve_host_app(tree) or previous.get("host_app")
    host_id = resolve_host_id() or previous.get("host_id")

    emit(path, {
        "schema": SCHEMA,
        "source": source,
        "session_id": session_id,
        "name": name,
        "cwd": cwd,
        "tty": tty,
        "host_app": host_app,
        "host_id": host_id,
        "event": get(payload, "hook_event_name", "hookEventName") or "",
        "state": state,
        "message": message,
        "asked": asked,
        "needs_action": needs_action,
        "notification_type": get(payload, "notification_type", "notificationType") or "",
        "transcript_path": get(payload, "transcript_path", "transcriptPath") or "",
        "ts": now,
    })


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
